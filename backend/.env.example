# Deployment
# "local" (default, Tauri desktop) or "remote" (RunPod/headless)
DEPLOY_MODE=local
HOST=0.0.0.0
PORT=8000

# API Keys
GROQ_API_KEY=
OPENAI_API_KEY=
INWORLD_API_KEY=
FISH_API_KEY=
DISCORD_TOKEN=

# PCVR Host
# IP of the machine running VRChat/SteamVR.
# Local: 127.0.0.1 (default). Remote via Tailscale: your machine's Tailscale IP.
PCVR_IP=127.0.0.1
VRCHAT_PORT=9000
OSC_PREFIX=/avatar/parameters
VRCHAT_PARAM_PREFIX=FT

# OSC Face
HOLD_SECONDS=2.0
TRANSITION_SECONDS=0.3
TRANSITION_STEPS=20
SEND_GAP_SECONDS=0.0
OSC_FACE_TEXT_FLUSH_MS=600

EMOTION_LLM_ENABLE=0
EMOTION_LLM_TIMEOUT_S=2.0
EMOTION_LLM_URL=https://api.groq.com/openai/v1/chat/completions
EMOTION_LLM_MODEL=moonshotai/kimi-k2-instruct-0905
FUSION_MODE=rule_first
FORCE_LLM=0
DEBUG_PRINT_MODEL_REPR=1
